# Leave unset until your own GTM container is configured and checked.
NEXT_PUBLIC_GTM_ID=
# GA4 is configured inside GTM, not loaded a second time in the source.
# Configure a certified CMP before enabling Google ads where required.
NEXT_PUBLIC_ENABLE_AD_SLOTS=false
# Confirm a working public email before filling this in.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: use only your own approved Amazon Associates tracking ID.
NEXT_PUBLIC_AMAZON_TAG=
