# Supply only your own confirmed GTM container. GA4 is configured inside GTM.
NEXT_PUBLIC_GTM_ID=
# Disabled by default. This reserves a space, it does not install or approve ads.
NEXT_PUBLIC_ENABLE_AD_SLOTS=false
# Confirmed public contact mailbox. Never put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_CONTACT_EMAIL=contact@versuspeak.com
